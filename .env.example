# Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# IMPORTANT: Change this password in production
DB_PASSWORD=YOUR_SECURE_PASSWORD
DB_NAME=ktdevelop_db
DB_CONNECTION_LIMIT=10

# Admin Authentication
# Used to sign the session token. Generate a random string for this.
ADMIN_SESSION_SECRET=change-this-session-secret-to-a-random-string

# Fallback/System Admin Credentials
ADMIN_USERNAME=admin
# IMPORTANT: Change this password in production
ADMIN_PASSWORD=YOUR_SECURE_ADMIN_PASSWORD
ADMIN_ACCESS_TOKEN=change-this-admin-token

# Allowed emails for Google Login (comma separated)
# ADMIN_GOOGLE_EMAILS=admin@example.com,manager@example.com

# Seed Admin Credentials (used by npm run db:seed:admin)
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@ktdevelop.local
# IMPORTANT: Change this password in production before running seed script
ADMIN_SEED_PASSWORD=YOUR_SECURE_SEED_PASSWORD

# Application Settings
NEXT_PUBLIC_LEAD_SLA_DAYS=3
# NEXT_PUBLIC_IMAGE_DOMAIN=images.ktdevelop.com